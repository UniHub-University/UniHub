# ----------------------------------------------------------------------------
# Modelo de variáveis de ambiente do Frontend UniHub.
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# O `.env.local` NÃO é versionado (contém configuração específica da máquina).
#
# No Vite, só variáveis com prefixo VITE_ ficam disponíveis no browser.
# ----------------------------------------------------------------------------

# URL base da API (sem barra no final).
# Local (API rodando na máquina):      http://localhost:5206
# Produção (Render):                   https://<seu-servico>.onrender.com
VITE_API_BASE_URL=https://seu-servico.onrender.com

# OAuth 2.0 Client ID (tipo "Web application") criado no Google Cloud Console.
# NÃO é um segredo (fica exposto no browser por natureza), mas mantemos em env
# para não travar em um ambiente só. Alinhe com o squad qual Client ID usar.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com